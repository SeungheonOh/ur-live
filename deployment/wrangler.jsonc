{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ur-live",
  "account_id": "e855335a6175305976cc984075979c30",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "preview_urls": false,
